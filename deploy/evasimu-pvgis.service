[Unit]
Description=Proxy PVGIS EVASIMU
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@UTILISATEUR@
Group=@UTILISATEUR@
WorkingDirectory=@RACINE@
EnvironmentFile=/etc/evasimu.env
# Contrairement à ce qui était écrit ici, l'ordre des directives ne décide pas :
# systemd donne la priorité aux valeurs d'EnvironmentFile, quelle que soit leur
# position. Ce « Environment=PORT= » était donc écrasé par le PORT du SaaS
# (8081) du fichier, le proxy se liait sur le port du SaaS, et le déploiement
# échouait sur EADDRINUSE puis un 404 à la sonde.
# On déclare donc la variable que le proxy lit en priorité, et qui ne peut être
# confondue avec celle du SaaS.
Environment=PORT_PVGIS=@PORT_PVGIS@
ExecStart=@NODE_BIN@ server/pvgis-proxy.js
Restart=always
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
