[Unit]
Description=SaaS EVASIMU (console, widgets, pages SEO)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@UTILISATEUR@
Group=@UTILISATEUR@
WorkingDirectory=@RACINE@
EnvironmentFile=/etc/evasimu.env
ExecStart=@NODE_BIN@ saas/server.js
Restart=always
RestartSec=3

# Le service n'a besoin que d'écrire sa base : tout le reste est en lecture seule.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@RACINE@/saas/data @RACINE@/sauvegardes
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
